{
  "name": "next-transfx-workspace",
  "private": true,
  "scripts": {
    "build": "bun run --filter next-transfx build",
    "check-types": "bun run build && bun run --filter '*' check-types",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --filter next-transfx test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
